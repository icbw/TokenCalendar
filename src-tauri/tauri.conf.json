{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenCalendar",
  "version": "0.3.7",
  "identifier": "com.tokencalendar.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TokenCalendar",
        "url": "index.html",
        "width": 1120,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "widget",
        "title": "TokenCalendar Widget",
        "url": "widget.html",
        "width": 1041,
        "height": 165,
        "minWidth": 480,
        "minHeight": 80,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "orb",
        "title": "TokenCalendar Orb",
        "url": "orb.html",
        "width": 32,
        "height": 96,
        "minWidth": 24,
        "minHeight": 64,
        "center": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
